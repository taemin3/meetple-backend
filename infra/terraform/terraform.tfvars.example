aws_region = "ap-northeast-2"

# ACM certificate must exist in the same region as the ALB.
# When null, the foundation exposes HTTP only until HTTPS is configured.
certificate_arn = null

# Existing Secrets Manager secrets. Secret values never belong in tfvars/state.
# backend_application_secret_arn must point to a JSON secret with the keys listed in README.md.
# firebase_credentials_secret_arn must point to the raw Firebase service-account JSON.
backend_application_secret_arn = "arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:meetple-staging-application-xxxxxx"
firebase_credentials_secret_arn = "arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:meetple-staging-firebase-xxxxxx"
# Add key ARNs only when either secret uses a customer-managed KMS key.
backend_secret_kms_key_arns = []

# Cost-conscious staging defaults. Review these before production.
ecs_instance_type    = "t3.large"
ecs_root_volume_size = 50
ecs_min_size         = 1
ecs_desired_capacity = 1
ecs_max_size         = 2

# First apply: keep desired_count=0 and use the placeholder tag.
# Run the staging workflow once so it activates a Git-SHA revision, then apply desired_count=1.
backend_image_tag          = "bootstrap"
backend_desired_count      = 0
kafka_consumer_concurrency = 1

# Native Flutter uploads do not need CORS. Add only trusted web origins when needed.
image_upload_allowed_origins = []
image_bucket_force_destroy    = false

# Single-broker staging defaults. Keep kafka_cluster_id stable after the first apply.
kafka_cluster_id       = "4L6g3nShT-eMCtK--X86sw"
kafka_topic_partitions = 3

# Logical replication safety limit. Monitor RDS FreeStorageSpace and replication slot lag.
rds_replication_slots         = 10
rds_max_slot_wal_keep_size_mb = 2048

db_instance_class        = "db.t4g.micro"
db_multi_az              = false
db_deletion_protection   = false
db_skip_final_snapshot   = true

additional_tags = {
  Owner = "replace-with-owner"
}

# GitHub Actions deployment is opt-in because the account-wide OIDC provider must be created only once.
# If another Terraform state already owns the provider, pass its ARN instead of creating a duplicate.
github_actions_deploy_enabled       = false
github_actions_repository           = "taemin3/meetple-backend"
github_actions_oidc_provider_arn    = null
