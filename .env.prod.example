# Public endpoint and Let's Encrypt account
API_DOMAIN=api.meetple.shop
CERTBOT_EMAIL=

# PostgreSQL (do not reuse development passwords)
POSTGRES_DB=meetple
POSTGRES_USER=meetple
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# Single-node Kafka
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_TOPIC_PARTITIONS=3

# JWT and verification signing secrets (use separate random values)
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600
EMAIL_VERIFICATION_HMAC_SECRET=

# Amazon SES SMTP (Seoul region)
MAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
EMAIL_FROM_ADDRESS=noreply@meetple.shop

# Email verification and password reset
EMAIL_VERIFICATION_CODE_TTL=5m
EMAIL_VERIFICATION_RESEND_COOLDOWN=1m
EMAIL_VERIFICATION_SIGNUP_TOKEN_TTL=15m
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL=15m

# Naver APIs
NAVER_LOCATION_BASE_URL=https://openapi.naver.com
NAVER_LOCATION_CLIENT_ID=
NAVER_LOCATION_CLIENT_SECRET=
NAVER_MAPS_BASE_URL=https://maps.apigw.ntruss.com
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=

# S3 image storage. Leave access keys empty when the EC2 IAM role grants access.
IMAGE_STORAGE_BUCKET=meetple-images
IMAGE_STORAGE_REGION=ap-northeast-2
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_PUBLIC_BASE_URL=
IMAGE_STORAGE_ACCESS_KEY=
IMAGE_STORAGE_SECRET_KEY=
IMAGE_STORAGE_KEY_PREFIX=images
IMAGE_STORAGE_UPLOAD_URL_EXPIRATION=5m
IMAGE_STORAGE_MAX_SIZE_BYTES=5242880
IMAGE_STORAGE_PATH_STYLE_ACCESS_ENABLED=false

# Kafka consumers used by current email and image workflows
EMAIL_DELIVERY_KAFKA_CONSUMER_ENABLED=true
IMAGE_DELETION_KAFKA_CONSUMER_ENABLED=true

# Enable only after production FCM credentials and Debezium Connect are configured.
PUSH_KAFKA_CONSUMER_ENABLED=false
PUSH_FCM_ENABLED=false

# Optional JVM tuning, for example: -Xms512m -Xmx1536m
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
